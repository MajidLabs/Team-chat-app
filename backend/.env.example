NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://chatuser:chatpass@localhost:5432/teamchat

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS - the origin your frontend is served from. "*" is fine for local dev.
CLIENT_ORIGIN=*

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Rate limiting
RATE_LIMIT_MESSAGES_PER_MIN=30
RATE_LIMIT_LOGIN_PER_15MIN=10

# How long (ms) a user's last socket can be gone before "offline" is
# actually broadcast - absorbs brief drops (sleeping laptop, flaky wifi)
# without flickering everyone's status. Set to 0 to disable debouncing.
PRESENCE_OFFLINE_GRACE_MS=5000
